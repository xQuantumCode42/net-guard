{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NetGuard", "version": "1.1.0", "identifier": "dev.netguard.desktop",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "label": "main", "title": "NetGuard", "width": 1180, "height": 800, "minWidth": 900, "minHeight": 620, "backgroundColor": "#f5f7fa" }], "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'" } },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"] }
}
